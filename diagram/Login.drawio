        <UserObject label="SQL Server&#xa;Database" plantUmlId="p_100" plantUmlBaseStyle="shape=cylinder3;size=6;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=14;html=1;shadow=0;strokeWidth=1;fontFamily=Verdana;part=1;" plantUmlBaseValue="SQL Server&#xa;Database" id="2gj_eSlcfn0yPFQNq1LW-339">
